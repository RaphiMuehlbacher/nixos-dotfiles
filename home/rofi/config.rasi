configuration {
  display-drun: "";
  drun-display-format: "{icon} {name}";
  font: "JetBrainsMono Nerd Font Medium 11";
  icon-theme: "Papirus";
  modi: "drun";
  show-icons: true;
}

@theme "/dev/null"

* {
  bg: #11121D;
  bg-alt: #1E2030;
  highlight: #7AA2F7;

  fg: #FFFFFF;
  fg-alt: #A9B1D6;

  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  background-color: @bg;
  text-color: @fg;
}

window {
  width: 40%;
  border: 2;
  border-radius: 12;
  border-color: @highlight;
  padding: 12;
}

mainbox {
  background-color: @bg;
  children: [ inputbar, listview ];
  spacing: 8;
}

inputbar {
  background-color: @bg-alt;
  border-radius: 8;
  padding: 8 12;
  spacing: 8;
  children: [ entry ];
}

entry {
  background-color: inherit;
  text-color: @fg;
  padding: 0;
}

listview {
  background-color: @bg;
  columns: 1;
  lines: 8;
  spacing: 4;
  padding: 8 0;
  border-radius: 8;
}

element {
  padding: 8 12;
  border-radius: 6;
  text-color: @fg-alt;
}

element selected {
  background-color: @highlight;
  text-color: @bg;
}

element-text {
  background-color: inherit;
  text-color: inherit;
  vertical-align: 0.5;
  highlight: #1C2450;
}

element-text selected {
  text-color: @fg;
}

element-icon {
  size: 26;
  padding: 0 8 0 0;
}

element-icon selected {
  background-color: inherit;
  text-color: @bg;
}
